---
import '../styles/global.css';

const title = 'Anki Vacation TTS';
const description =
    'Open-source generator for Anki travel phrase decks with native audio, IPA and a pronunciation guide you can actually read.';
const repoUrl = 'https://github.com/lorenzpfei/anki-vacation-tts';

const names = new Intl.DisplayNames(['en'], { type: 'language' });
const flag = (lang: string) =>
    String.fromCodePoint(
        ...[...lang.slice(-2)].map(char => 0x1f1a5 + char.charCodeAt(0))
    );
const decks = Object.values(
    import.meta.glob<{ targetLang: string; cards: unknown[] }>(
        '../../../generator/decks/*.json',
        { eager: true, import: 'default' }
    )
)
    .map(deck => ({
        name: names.of(deck.targetLang),
        flag: flag(deck.targetLang),
        cards: deck.cards.length,
    }))
    .sort((a, b) => a.name!.localeCompare(b.name!));
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="icon" href="/logo.png" />
    </head>
    <body>
        <div class="hero-band">
            <div class="page">
                <header class="nav">
                    <a href="/" class="wordmark">
                        <img src="/logo.png" alt="" width="24" height="24" />
                        Anki Vacation TTS
                    </a>
                    <a href={repoUrl} class="nav-link">GitHub</a>
                </header>

                <section class="hero">
                    <div>
                        <h1>
                            The phrases you'll <em>actually</em> use abroad.
                        </h1>
                        <p class="lead">
                            Anki Vacation TTS builds small flashcard decks for
                            a trip: the greetings, orders and questions locals
                            really use, each with natural audio, IPA and a
                            spelling you can pronounce at first sight.
                        </p>
                        <div class="actions">
                            <a href="#setup" class="button">Make a deck</a>
                            <a href={repoUrl} class="button button-ghost"
                                >Source on GitHub</a
                            >
                        </div>
                        <p class="fineprint">
                            Free and open source, MIT licensed.
                        </p>
                    </div>

                    <figure class="demo">
                        <div class="card" id="card" role="button" tabindex="0">
                            <div class="face front">
                                <span class="chip">🇨🇳 Mandarin · say it</span>
                                <p class="cue">How much is this?</p>
                                <p class="context">
                                    Asking the price at a market or in a shop.
                                </p>
                                <span class="hint">Tap to flip →</span>
                            </div>
                            <div class="face back">
                                <span class="chip">🇨🇳 Mandarin · say it</span>
                                <div class="answer">
                                    <p class="l2" lang="zh-CN">多少钱？</p>
                                    <button
                                        class="play"
                                        id="play"
                                        type="button"
                                        aria-label="Play audio"
                                    >
                                        <svg
                                            viewBox="0 0 24 24"
                                            width="18"
                                            height="18"
                                            aria-hidden="true"
                                            ><path
                                                d="M7 4.5v15l12-7.5z"
                                                fill="currentColor"></path></svg
                                        >
                                    </button>
                                </div>
                                <dl class="facts">
                                    <dt>Simple</dt>
                                    <dd class="simple">duōshao qián?</dd>
                                    <dt>IPA</dt>
                                    <dd>two˥ ʂɑʊ̯ tɕʰjɛn˧˥</dd>
                                    <dt>Literal</dt>
                                    <dd>How much money?</dd>
                                </dl>
                                <p class="usage">
                                    Point at the item and ask. The seller often
                                    types the price into a calculator.
                                </p>
                            </div>
                        </div>
                        <figcaption>
                            A real card from the Mandarin deck, translated to
                            English. Tap it, then play the audio.
                        </figcaption>
                    </figure>
                </section>
            </div>
        </div>

        <div class="page">
            <section class="section">
                <h2>What goes into a deck</h2>
                <div class="tiles">
                    <div class="tile tile-mint">
                        <span class="sample" lang="tr">Kartla?</span>
                        <h3>Phrases locals say</h3>
                        <p>
                            One best phrase per situation, in its shortest
                            natural form, instead of "Could I pay by card,
                            please?".
                        </p>
                    </div>
                    <div class="tile tile-sand">
                        <span class="sample" lang="tr"
                            >Hoş geldiniz → Hoş bulduk</span
                        >
                        <h3>Calls and responses</h3>
                        <p>
                            Fixed rituals are learned as a pair: what you hear,
                            and what you say back.
                        </p>
                    </div>
                    <div class="tile tile-lilac">
                        <span class="sample" lang="hi">हाँ · hã</span>
                        <h3>A second opinion</h3>
                        <p>
                            Every deck is drafted, then reviewed again for stiff
                            phrasing, wrong tones and misleading transcriptions
                            before any audio is made.
                        </p>
                    </div>
                </div>
            </section>

            <section class="section" id="setup">
                <h2>Make a deck</h2>
                <p class="section-lead">
                    You need Node.js 22, a Gemini API key for writing the deck
                    and a key for the voice you pick (Gemini, Azure, Google or
                    ElevenLabs).
                </p>
                <pre><code><span class="c"># once</span>
git clone https://github.com/lorenzpfei/anki-vacation-tts.git
cd anki-vacation-tts/generator && pnpm install && cp .env.example .env

<span class="c"># draft and review a new deck</span>
node generate.js new --target zh-CN --region <span class="s">"mainland China"</span>

<span class="c"># synthesize audio and package it</span>
node generate.js deDE-zhCN</code></pre>
                <p class="section-lead">
                    The last step writes <code>output/deDE-zhCN.apkg</code>.
                    Open it in Anki and the note type, card templates and audio
                    are all there.
                </p>
            </section>

            <section class="section">
                <h2>Decks in the repository</h2>
                <p class="section-lead">
                    These are written for German speakers. Use
                    <code>--learner en-US</code> to generate decks with English
                    explanations.
                </p>
                <ul class="decks">
                    {
                        decks.map(deck => (
                            <li>
                                <span class="flag">{deck.flag}</span>
                                <span>{deck.name}</span>
                                <span class="count">{deck.cards} cards</span>
                            </li>
                        ))
                    }
                </ul>
            </section>

            <section class="section">
                <h2>Why flashcards</h2>
                <p class="quote">
                    Anki asks you to recall a phrase before showing it, and
                    schedules each card right before you would forget it. Both
                    effects are well studied: <a
                        href="https://pmc.ncbi.nlm.nih.gov/articles/PMC10403443/"
                        >Anki use and outcomes</a
                    >, <a href="https://ijms.pitt.edu/IJMS/article/view/1549"
                        >spaced repetition</a
                    >. A trip deck of around 50 cards takes a few minutes a day
                    over two or three weeks.
                </p>
            </section>
        </div>

        <footer class="footer">
            <div class="page footer-inner">
                <span class="wordmark">
                    <img src="/logo.png" alt="" width="20" height="20" />
                    Anki Vacation TTS
                </span>
                <a href={repoUrl}>GitHub</a>
            </div>
        </footer>

        <script is:inline>
            const card = document.getElementById('card');
            const audio = new Audio('/audio/mandarin-how-much.mp3');
            const flip = () => card.classList.toggle('flipped');
            card.addEventListener('click', event => {
                if (!event.target.closest('#play')) flip();
            });
            card.addEventListener('keydown', event => {
                if (event.key === 'Enter' || event.key === ' ') {
                    event.preventDefault();
                    flip();
                }
            });
            document.getElementById('play').addEventListener('click', () => {
                audio.currentTime = 0;
                audio.play();
            });
        </script>

        <style is:global>
            :root {
                --paper: #fcfbf8;
                --ink: #12283a;
                --ink-soft: #546575;
                --line: #e3e7e6;
                --teal: #12a17c;
                --teal-dark: #0c7c5f;
                --mint: #e3f5ee;
                --sand: #fbefd9;
                --lilac: #ece8fb;
                --amber: #f2b24c;
            }
            html {
                background: var(--paper);
                color: var(--ink);
            }
            body {
                margin: 0;
                font-family: 'InterVariable', system-ui, sans-serif;
                font-size: 17px;
                line-height: 1.6;
                color: var(--ink);
                background: var(--paper);
            }
            a {
                color: inherit;
            }
            h1,
            h2,
            h3 {
                font-family: 'Switzer-Semibold', 'InterVariable', sans-serif;
                font-weight: 600;
                letter-spacing: -0.01em;
                margin: 0;
            }
            code {
                font-family: ui-monospace, 'SF Mono', Menlo, monospace;
                font-size: 0.88em;
            }
            .page {
                max-width: 1080px;
                margin: 0 auto;
                padding: 0 24px;
            }
            .hero-band {
                background: linear-gradient(
                    180deg,
                    var(--mint) 0%,
                    var(--paper) 100%
                );
            }
            .nav {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 22px 0;
            }
            .wordmark {
                display: inline-flex;
                align-items: center;
                gap: 10px;
                font-weight: 600;
                text-decoration: none;
            }
            .nav-link {
                font-weight: 500;
                text-decoration: none;
                color: var(--ink-soft);
            }
            .nav-link:hover {
                color: var(--teal-dark);
            }
            .hero {
                display: grid;
                grid-template-columns: 1.1fr 1fr;
                gap: 64px;
                align-items: center;
                padding: 48px 0 96px;
            }
            .hero h1 {
                font-size: clamp(2.3rem, 4.6vw, 3.5rem);
                line-height: 1.06;
            }
            .hero h1 em {
                font-style: normal;
                color: var(--teal);
                background: linear-gradient(transparent 68%, #bfeadb 68%);
            }
            .lead {
                margin: 22px 0 0;
                max-width: 34em;
                color: var(--ink-soft);
                font-size: 1.12rem;
            }
            .actions {
                display: flex;
                flex-wrap: wrap;
                gap: 12px;
                margin-top: 32px;
            }
            .button {
                display: inline-block;
                padding: 11px 20px;
                border-radius: 10px;
                background: var(--teal);
                color: #fff;
                text-decoration: none;
                font-weight: 600;
                transition: background 0.15s;
            }
            .button:hover {
                background: var(--teal-dark);
            }
            .button-ghost {
                background: #fff;
                color: var(--ink);
                box-shadow: inset 0 0 0 1px var(--line);
            }
            .button-ghost:hover {
                background: #fff;
                box-shadow: inset 0 0 0 1px var(--ink);
            }
            .fineprint {
                margin: 18px 0 0;
                font-size: 0.85rem;
                color: var(--ink-soft);
            }
            .demo {
                margin: 0;
                perspective: 1200px;
            }
            .card {
                position: relative;
                height: 350px;
                cursor: pointer;
                transform-style: preserve-3d;
                transition: transform 0.5s cubic-bezier(0.3, 0, 0.2, 1);
                outline: none;
            }
            .card.flipped {
                transform: rotateY(180deg);
            }
            .card:focus-visible .face {
                box-shadow: 0 0 0 3px var(--teal);
            }
            .face {
                position: absolute;
                inset: 0;
                display: flex;
                flex-direction: column;
                padding: 28px;
                background: #fff;
                border-radius: 18px;
                border-top: 6px solid var(--teal);
                box-shadow:
                    0 1px 2px rgb(18 40 58 / 0.06),
                    0 18px 40px -18px rgb(18 40 58 / 0.25);
                backface-visibility: hidden;
            }
            .back {
                transform: rotateY(180deg);
                border-top-color: var(--amber);
            }
            .chip {
                align-self: flex-start;
                padding: 3px 10px;
                border-radius: 999px;
                background: var(--mint);
                color: var(--teal-dark);
                font-size: 0.78rem;
                font-weight: 600;
            }
            .back .chip {
                background: var(--sand);
                color: #8a5a10;
            }
            .cue {
                margin: auto 0 0;
                font-family: 'Switzer-Semibold', sans-serif;
                font-size: 2rem;
                line-height: 1.2;
            }
            .context {
                margin: 8px 0 auto;
                color: var(--ink-soft);
            }
            .hint {
                font-size: 0.85rem;
                font-weight: 600;
                color: var(--teal);
            }
            .answer {
                display: flex;
                align-items: center;
                gap: 16px;
                margin-top: 16px;
            }
            .l2 {
                margin: 0;
                font-size: 2.7rem;
                line-height: 1.1;
                font-weight: 500;
            }
            .play {
                display: grid;
                place-items: center;
                width: 44px;
                height: 44px;
                border: 0;
                border-radius: 50%;
                background: var(--teal);
                color: #fff;
                cursor: pointer;
                box-shadow: 0 6px 16px -6px rgb(18 161 124 / 0.6);
                transition: transform 0.15s;
            }
            .play:hover {
                transform: scale(1.06);
            }
            .play:active {
                transform: scale(0.96);
            }
            .facts {
                display: grid;
                grid-template-columns: auto 1fr;
                gap: 4px 16px;
                margin: 18px 0 0;
                font-size: 0.95rem;
            }
            .facts dt {
                color: var(--ink-soft);
            }
            .facts dd {
                margin: 0;
            }
            .facts .simple {
                font-weight: 600;
                color: var(--teal-dark);
            }
            .usage {
                margin: auto 0 0;
                font-size: 0.9rem;
                color: var(--ink-soft);
            }
            figcaption {
                margin-top: 14px;
                font-size: 0.85rem;
                color: var(--ink-soft);
            }
            .section {
                padding: 64px 0;
            }
            .section + .section {
                border-top: 1px solid var(--line);
            }
            .section h2 {
                font-size: 1.7rem;
            }
            .section-lead {
                max-width: 40em;
                margin: 12px 0 0;
                color: var(--ink-soft);
            }
            .tiles {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 20px;
                margin-top: 28px;
            }
            .tile {
                padding: 24px;
                border-radius: 16px;
            }
            .tile-mint {
                background: var(--mint);
            }
            .tile-sand {
                background: var(--sand);
            }
            .tile-lilac {
                background: var(--lilac);
            }
            .sample {
                display: inline-block;
                margin-bottom: 16px;
                padding: 4px 12px;
                border-radius: 8px;
                background: #fff;
                font-weight: 600;
                box-shadow: 0 1px 2px rgb(18 40 58 / 0.08);
            }
            .tile h3 {
                font-size: 1.1rem;
            }
            .tile p {
                margin: 6px 0 0;
                color: var(--ink-soft);
            }
            pre {
                margin: 24px 0;
                padding: 22px 26px;
                overflow-x: auto;
                background: var(--ink);
                color: #e8eef2;
                border-radius: 14px;
                line-height: 1.75;
            }
            pre .c {
                color: #7fd4b8;
            }
            pre .s {
                color: var(--amber);
            }
            .section-lead code {
                padding: 2px 6px;
                border-radius: 6px;
                background: var(--mint);
                color: var(--teal-dark);
            }
            .decks {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
                gap: 12px;
                margin: 28px 0 0;
                padding: 0;
                list-style: none;
            }
            .decks li {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 14px 16px;
                background: #fff;
                border: 1px solid var(--line);
                border-radius: 12px;
                font-weight: 500;
            }
            .flag {
                font-size: 1.4rem;
                line-height: 1;
            }
            .count {
                margin-left: auto;
                font-size: 0.85rem;
                font-weight: 400;
                color: var(--ink-soft);
            }
            .quote {
                max-width: 44em;
                margin: 16px 0 0;
                padding-left: 20px;
                border-left: 4px solid var(--teal);
                color: var(--ink-soft);
            }
            .quote a {
                color: var(--teal-dark);
            }
            .footer {
                background: var(--ink);
                color: #c9d4dc;
                font-size: 0.9rem;
            }
            .footer-inner {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding-top: 28px;
                padding-bottom: 28px;
            }
            .footer .wordmark {
                color: #fff;
            }
            @media (max-width: 860px) {
                .hero {
                    grid-template-columns: 1fr;
                    gap: 40px;
                    padding-top: 16px;
                }
                .tiles {
                    grid-template-columns: 1fr;
                }
            }
        </style>
    </body>
</html>
