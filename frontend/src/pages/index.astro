---
import '../styles/global.css';

const title = 'Anki Vacation TTS';
const description =
    'Open-source generator for Anki travel phrase decks with native audio, IPA and a pronunciation guide you can actually read.';
const repoUrl = 'https://github.com/lorenzpfei/anki-vacation-tts';

const decks = [
    ['Mandarin', 'zh-CN', 51],
    ['Hindi', 'hi-IN', 48],
    ['French', 'fr-FR', 96],
    ['Arabic (Syrian)', 'ar-SY', 92],
    ['Japanese', 'ja-JP', 69],
    ['Korean', 'ko-KR', 52],
    ['Turkish', 'tr-TR', 51],
];
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="icon" href="/logo.png" />
    </head>
    <body>
        <div class="page">
            <header class="nav">
                <a href="/" class="wordmark">
                    <img src="/logo.png" alt="" width="20" height="20" />
                    Anki Vacation TTS
                </a>
                <a href={repoUrl} class="nav-link">GitHub</a>
            </header>

            <section class="hero">
                <div class="hero-text">
                    <h1>The phrases you'll actually use abroad.</h1>
                    <p class="lead">
                        Anki Vacation TTS builds small flashcard decks for a
                        trip: the greetings, orders and questions locals
                        really use, each with natural audio, IPA and a
                        spelling you can pronounce at first sight.
                    </p>
                    <div class="actions">
                        <a href="#setup" class="button">Make a deck</a>
                        <a href={repoUrl} class="text-link"
                            >Source on GitHub</a
                        >
                    </div>
                    <p class="fineprint">Free and open source, MIT licensed.</p>
                </div>

                <figure class="demo">
                    <div class="card" id="card" role="button" tabindex="0">
                        <div class="face front">
                            <span class="label">Mandarin · say it</span>
                            <p class="cue">How much is this?</p>
                            <p class="context">
                                Asking the price at a market or in a shop.
                            </p>
                            <span class="hint">Tap to flip</span>
                        </div>
                        <div class="face back">
                            <span class="label">Mandarin · say it</span>
                            <div class="answer">
                                <p class="l2" lang="zh-CN">多少钱？</p>
                                <button
                                    class="play"
                                    id="play"
                                    type="button"
                                    aria-label="Play audio"
                                >
                                    <svg
                                        viewBox="0 0 24 24"
                                        width="16"
                                        height="16"
                                        aria-hidden="true"
                                        ><path
                                            d="M7 4.5v15l12-7.5z"
                                            fill="currentColor"></path></svg
                                    >
                                </button>
                            </div>
                            <dl class="facts">
                                <dt>Simple</dt>
                                <dd>duōshao qián?</dd>
                                <dt>IPA</dt>
                                <dd>two˥ ʂɑʊ̯ tɕʰjɛn˧˥</dd>
                                <dt>Literal</dt>
                                <dd>How much money?</dd>
                            </dl>
                            <p class="usage">
                                Point at the item and ask. The seller often
                                types the price into a calculator.
                            </p>
                        </div>
                    </div>
                    <figcaption>
                        A real card from the Mandarin deck, translated to
                        English.
                    </figcaption>
                </figure>
            </section>

            <section class="section">
                <h2>What goes into a deck</h2>
                <div class="columns">
                    <div>
                        <h3>Phrases locals say</h3>
                        <p>
                            One best phrase per situation, in its shortest
                            natural form. "Kartla?" instead of "Could I pay by
                            card, please?".
                        </p>
                    </div>
                    <div>
                        <h3>Calls and responses</h3>
                        <p>
                            Fixed rituals like Turkish "Hoş geldiniz" → "Hoş
                            bulduk" are learned as a pair: what you hear, and
                            what you say back.
                        </p>
                    </div>
                    <div>
                        <h3>A second opinion</h3>
                        <p>
                            Every new deck is drafted, then reviewed again for
                            stiff phrasing, wrong tones and bad transcriptions
                            before any audio is made.
                        </p>
                    </div>
                </div>
            </section>

            <section class="section" id="setup">
                <h2>Make a deck</h2>
                <p class="section-lead">
                    You need Node.js 22, a Gemini API key for writing the deck
                    and a key for the voice you pick (Gemini, Azure, Google or
                    ElevenLabs).
                </p>
                <pre><code><span class="dim"># once</span>
git clone https://github.com/lorenzpfei/anki-vacation-tts.git
cd anki-vacation-tts/generator && pnpm install && cp .env.example .env

<span class="dim"># draft and review a new deck</span>
node generate.js new --target zh-CN --region "mainland China"

<span class="dim"># synthesize audio and package it</span>
node generate.js deDE-zhCN</code></pre>
                <p class="section-lead">
                    The last step writes <code>output/deDE-zhCN.apkg</code>.
                    Open it in Anki and the note type, card templates and audio
                    are all there.
                </p>
            </section>

            <section class="section">
                <h2>Decks in the repository</h2>
                <p class="section-lead">
                    These are written for German speakers. Use
                    <code>--learner en-US</code> to generate decks with English
                    explanations.
                </p>
                <ul class="decks">
                    {
                        decks.map(([name, code, cards]) => (
                            <li>
                                <span>{name}</span>
                                <span class="dim">
                                    {code} · {cards} cards
                                </span>
                            </li>
                        ))
                    }
                </ul>
            </section>

            <section class="section">
                <h2>Why flashcards</h2>
                <p class="section-lead">
                    Anki asks you to recall a phrase before showing it, and
                    schedules each card right before you would forget it. Both
                    effects are well studied: <a
                        href="https://pmc.ncbi.nlm.nih.gov/articles/PMC10403443/"
                        >Anki use and outcomes</a
                    >, <a href="https://ijms.pitt.edu/IJMS/article/view/1549"
                        >spaced repetition</a
                    >. A trip deck of around 50 cards takes a few minutes a day
                    over two or three weeks.
                </p>
            </section>

            <footer class="footer">
                <span>Anki Vacation TTS</span>
                <a href={repoUrl}>GitHub</a>
            </footer>
        </div>

        <script is:inline>
            const card = document.getElementById('card');
            const audio = new Audio('/audio/mandarin-how-much.mp3');
            const flip = () => card.classList.toggle('flipped');
            card.addEventListener('click', event => {
                if (!event.target.closest('#play')) flip();
            });
            card.addEventListener('keydown', event => {
                if (event.key === 'Enter' || event.key === ' ') {
                    event.preventDefault();
                    flip();
                }
            });
            document.getElementById('play').addEventListener('click', () => {
                audio.currentTime = 0;
                audio.play();
            });
        </script>

        <style is:global>
            :root {
                --paper: #fbfaf8;
                --ink: #191917;
                --ink-soft: #5f5e5a;
                --line: #e7e4de;
                --accent: #b3261e;
            }
            html {
                background: var(--paper);
                color: var(--ink);
            }
            body {
                margin: 0;
                font-family: 'InterVariable', system-ui, sans-serif;
                font-size: 17px;
                line-height: 1.6;
                color: var(--ink);
                background: var(--paper);
            }
            a {
                color: inherit;
            }
            h1,
            h2,
            h3 {
                font-family: 'Switzer-Semibold', 'InterVariable', sans-serif;
                font-weight: 600;
                letter-spacing: -0.01em;
                margin: 0;
            }
            code {
                font-family: ui-monospace, 'SF Mono', Menlo, monospace;
                font-size: 0.88em;
            }
            .page {
                max-width: 1040px;
                margin: 0 auto;
                padding: 0 24px;
            }
            .dim {
                color: var(--ink-soft);
            }
            .nav {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 24px 0;
            }
            .wordmark {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                font-weight: 600;
                text-decoration: none;
            }
            .nav-link,
            .text-link {
                color: var(--ink-soft);
                text-decoration: none;
            }
            .nav-link:hover,
            .text-link:hover {
                color: var(--ink);
            }
            .hero {
                display: grid;
                grid-template-columns: 1.1fr 1fr;
                gap: 64px;
                align-items: center;
                padding: 56px 0 88px;
            }
            .hero h1 {
                font-size: clamp(2.2rem, 4.5vw, 3.3rem);
                line-height: 1.08;
            }
            .lead {
                margin: 20px 0 0;
                max-width: 34em;
                color: var(--ink-soft);
                font-size: 1.1rem;
            }
            .actions {
                display: flex;
                align-items: center;
                gap: 24px;
                margin-top: 32px;
            }
            .button {
                display: inline-block;
                padding: 10px 18px;
                border-radius: 8px;
                background: var(--ink);
                color: var(--paper);
                text-decoration: none;
                font-weight: 500;
            }
            .button:hover {
                background: #000;
            }
            .fineprint {
                margin: 20px 0 0;
                font-size: 0.85rem;
                color: var(--ink-soft);
            }
            .demo {
                margin: 0;
                perspective: 1200px;
            }
            .card {
                position: relative;
                height: 340px;
                cursor: pointer;
                transform-style: preserve-3d;
                transition: transform 0.5s cubic-bezier(0.3, 0, 0.2, 1);
                outline: none;
            }
            .card.flipped {
                transform: rotateY(180deg);
            }
            .card:focus-visible .face {
                box-shadow: 0 0 0 2px var(--ink);
            }
            .face {
                position: absolute;
                inset: 0;
                display: flex;
                flex-direction: column;
                padding: 28px;
                background: #fff;
                border: 1px solid var(--line);
                border-radius: 14px;
                box-shadow: 0 1px 2px rgb(0 0 0 / 0.04);
                backface-visibility: hidden;
            }
            .back {
                transform: rotateY(180deg);
            }
            .label {
                font-size: 0.75rem;
                letter-spacing: 0.06em;
                text-transform: uppercase;
                color: var(--ink-soft);
            }
            .cue {
                margin: auto 0 0;
                font-family: 'Switzer-Semibold', sans-serif;
                font-size: 1.9rem;
                line-height: 1.2;
            }
            .context {
                margin: 8px 0 auto;
                color: var(--ink-soft);
            }
            .hint {
                font-size: 0.8rem;
                color: var(--ink-soft);
            }
            .answer {
                display: flex;
                align-items: center;
                gap: 16px;
                margin-top: 18px;
            }
            .l2 {
                margin: 0;
                font-size: 2.6rem;
                line-height: 1.1;
                font-weight: 500;
            }
            .play {
                display: grid;
                place-items: center;
                width: 40px;
                height: 40px;
                border: 1px solid var(--line);
                border-radius: 50%;
                background: #fff;
                color: var(--accent);
                cursor: pointer;
            }
            .play:hover {
                border-color: var(--accent);
            }
            .facts {
                display: grid;
                grid-template-columns: auto 1fr;
                gap: 4px 16px;
                margin: 20px 0 0;
                font-size: 0.95rem;
            }
            .facts dt {
                color: var(--ink-soft);
            }
            .facts dd {
                margin: 0;
            }
            .usage {
                margin: auto 0 0;
                font-size: 0.9rem;
                color: var(--ink-soft);
            }
            figcaption {
                margin-top: 12px;
                font-size: 0.85rem;
                color: var(--ink-soft);
            }
            .section {
                padding: 56px 0;
                border-top: 1px solid var(--line);
            }
            .section h2 {
                font-size: 1.5rem;
            }
            .section-lead {
                max-width: 40em;
                margin: 12px 0 0;
                color: var(--ink-soft);
            }
            .section-lead a {
                color: var(--ink);
            }
            .columns {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 40px;
                margin-top: 28px;
            }
            .columns h3 {
                font-size: 1.05rem;
            }
            .columns p {
                margin: 8px 0 0;
                color: var(--ink-soft);
            }
            pre {
                margin: 24px 0;
                padding: 20px 24px;
                overflow-x: auto;
                background: #fff;
                border: 1px solid var(--line);
                border-radius: 10px;
                line-height: 1.7;
            }
            .decks {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 0 40px;
                margin: 24px 0 0;
                padding: 0;
                list-style: none;
            }
            .decks li {
                display: flex;
                justify-content: space-between;
                padding: 10px 0;
                border-bottom: 1px solid var(--line);
            }
            .footer {
                display: flex;
                justify-content: space-between;
                padding: 32px 0 48px;
                border-top: 1px solid var(--line);
                font-size: 0.9rem;
                color: var(--ink-soft);
            }
            @media (max-width: 820px) {
                .hero {
                    grid-template-columns: 1fr;
                    gap: 40px;
                    padding-top: 24px;
                }
                .columns,
                .decks {
                    grid-template-columns: 1fr;
                }
                .columns {
                    gap: 24px;
                }
            }
        </style>
    </body>
</html>
